{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SnipLingo",
  "version": "0.1.2",
  "identifier": "com.sniplingo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnipLingo",
        "width": 546,
        "height": 406,
        "minWidth": 440,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site"
      },
      {
        "label": "capture",
        "title": "SnipLingo Capture",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "shadow": false
      },
      {
        "label": "result",
