    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "copyright": "Copyright © 2026 SnipLingo Team",
    "shortDescription": "桌面极速截图、贴图与翻译助理",
    "longDescription": "SnipLingo 是一款为 Windows 用户量身打造的现代轻量桌面极速截图、贴图与翻译助理，支持屏幕取词、离线 OCR、就地译图、多引擎翻译与浮动贴图。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English",
          "TradChinese"
        ],
        "displayLanguageSelector": false
      }
    }
